ARXIV_CATEGORIES=astro-ph.GA,astro-ph.CO
ARXIV_KEYWORDS=galaxy,cosmology,black hole,star formation
DIGEST_TIMEZONE=Asia/Shanghai
ARXIV_FETCH_MAX_RESULTS=100
ARXIV_PAGE_SIZE=25
ARXIV_MAX_PAGES=4
ARXIV_PAGE_DELAY_SECONDS=3
ARXIV_REQUEST_TIMEOUT=60
ARXIV_REQUEST_RETRIES=5
ARXIV_RATE_LIMIT_BACKOFF_BASE=60
ARXIV_RATE_LIMIT_BACKOFF_MAX=600
ARXIV_RATE_LIMIT_BACKOFF_JITTER=30
ARXIV_RATE_LIMIT_GRACEFUL=true
MAX_PAPERS=14
MAX_LLM_PAPERS=14
MAX_ABSTRACT_CHARS=1800
LLM_BATCH_SIZE=5
MIN_RATING=1
LOOKBACK_DAYS=1
DEEP_PAPERS=4
BRIEF_PAPERS=10

CALENDAR_ENABLED=true
CALENDAR_EVENTS_PATH=config/events.yaml
CALENDAR_CONFERENCES_PATH=config/conferences.yaml
CALENDAR_HORIZON_DAYS=120
CALENDAR_RECENT_DAYS=14

# —— 模型端点 ——
# OpenAI：OPENAI_BASE_URL 留空，OPENAI_MODEL=gpt-4o-mini（或 gpt-4o）
# DeepSeek：下面三行照着填即可（模型名 2026-10 官方为 deepseek-flash / deepseek-v4-pro）
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# DeepSeek 示例：
#   OPENAI_BASE_URL=https://api.deepseek.com
#   OPENAI_MODEL=deepseek-flash

# —— 两阶段分析与读者画像 ——
# false = 只发"中文摘要"版（旧行为）；true = 精读那几篇走"抽事实 → 按画像评估"
ANALYSIS_ENABLED=false
# 留空 = 跟随 OPENAI_MODEL。省钱可以抽取用便宜模型、评论用强模型：
#   ANALYSIS_EXTRACT_MODEL=deepseek-flash
#   ANALYSIS_ASSESS_MODEL=deepseek-v4-pro
ANALYSIS_EXTRACT_MODEL=
ANALYSIS_ASSESS_MODEL=
# 思考模式（DeepSeek 默认开启、且思考 token 按输出计费）——三态：
#   留空 = 不发这个参数（OpenAI 等端点必须留空，否则 400）
#   false = 显式关闭（结构化抽取建议关：快、省、结果更稳定）
#   true  = 显式开启（写评论、写脉搏可以开）
ANALYSIS_EXTRACT_THINKING=false
ANALYSIS_ASSESS_THINKING=
LLM_THINKING=
PROFILE_PATH=config/profile.yaml
PACKS_DIR=config/packs
# 勾选领域包；留空 = 全部启用（不影响 ARXIV_CATEGORIES 这个逃生通道）
FIELDS=galaxy_cosmology,galaxy_formation
# 留空 = 不落盘；填 digest.json 可回放这一期
DIGEST_JSON_PATH=

# —— 全文 PDF（精读用）——
# 精读那几篇会下 PDF 抽正文：摘要里永远没有"样本怎么选、误差怎么校正"
FULLTEXT_ENABLED=true
# 送进模型的正文上限（字符）。太大贵、太小丢信息；40k ≈ 一万 token
FULLTEXT_MAX_CHARS=40000
FULLTEXT_MAX_PAGES=40
FULLTEXT_TIMEOUT=120

# —— 多源：二手解读（RSS）与会议报告（Indico）——
# 关掉就退回"只有 arXiv"的旧行为
SOURCES_ENABLED=true
SOURCES_PATH=config/sources.yaml
# 每个源最多取几条；四个源就是最多 SOURCES_MAX_ITEMS×源数 条
SOURCES_MAX_ITEMS=6
SOURCES_TIMEOUT=30

# —— 跨天状态：已读过滤 + 周环比 ——
# 必须写进仓库（Actions 每次都是干净文件系统），否则天天推同一批
STATE_PATH=state.json
TREND_ENABLED=true
# 邮件里最多显示几行趋势
TREND_ROWS=4

ZOTERO_API_KEY=
ZOTERO_USER_ID=
ZOTERO_LIBRARY_TYPE=user
ZOTERO_COLLECTION_ID=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 邮件里附一份 HTML，方便下载转发（默认 true）
EMAIL_ATTACH_HTML=true
EMAIL_FROM=
EMAIL_TO=

# ---- 本周脉搏（把"新动向"从罗列日程升级为判断什么在动）----
PULSE_ENABLED=true
# PULSE_MODEL 留空则用 OPENAI_MODEL
PULSE_MODEL=
PULSE_THREADS=4
PULSE_MAX_MATERIALS=30
# ── 邻域雷达（别的方向这周在动什么）────────────────────────
RADAR_ENABLED=true
RADAR_PATH=config/radar.yaml
RADAR_PER_FIELD=1
RADAR_MAX_FIELDS=5
RADAR_LOOKBACK_DAYS=7

# ── 二手解读中文翻译 ──────────────────────────────────────
TRANSLATE_ENABLED=true
# TRANSLATE_LIMIT 留空则 40（二手源总数也就 20-40 条，够全译）
TRANSLATE_LIMIT=
# TRANSLATE_THINKING 留空则跟随模型默认（DeepSeek 关、其他开）
TRANSLATE_THINKING=
# RADAR_THINKING 留空则跟随模型默认
RADAR_THINKING=

# ── 邮件主题 ─────────────────────────────────────────────
# dark（默认，深空冷色）/ light（暖纸浅色）
EMAIL_THEME=dark

# ── 反馈闭环（留空则邮件里不显示反馈按钮）─────────────────
FEEDBACK_URL=
FEEDBACK_PATH=config/feedback.json
