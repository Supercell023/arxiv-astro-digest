# 留空按 FIELDS 所选领域包取分类并集；显式填写会覆盖领域包分类。
ARXIV_CATEGORIES=
ARXIV_KEYWORDS=galaxy,cosmology,black hole,star formation
DIGEST_TIMEZONE=Asia/Shanghai
ARXIV_FETCH_MAX_RESULTS=100
ARXIV_PAGE_SIZE=25
ARXIV_MAX_PAGES=4
ARXIV_PAGE_DELAY_SECONDS=3
ARXIV_REQUEST_TIMEOUT=60
ARXIV_REQUEST_RETRIES=5
ARXIV_RATE_LIMIT_BACKOFF_BASE=60
ARXIV_RATE_LIMIT_BACKOFF_MAX=600
ARXIV_RATE_LIMIT_BACKOFF_JITTER=30
ARXIV_RATE_LIMIT_GRACEFUL=true
MAX_PAPERS=14
MAX_LLM_PAPERS=14
MAX_ABSTRACT_CHARS=1800
LLM_BATCH_SIZE=5
MIN_RATING=1
LOOKBACK_DAYS=1
# 精读/速览的篇数。以前这两项还兼着"20 分钟预算"，现在只决定排版：
# 内容多少由模型按证据决定，不再为了卡时长删掉研究背景与方法细节。
DEEP_PAPERS=4
BRIEF_PAPERS=10

CALENDAR_ENABLED=true
CALENDAR_EVENTS_PATH=config/events.yaml
CALENDAR_CONFERENCES_PATH=config/conferences.yaml
CALENDAR_HORIZON_DAYS=120
CALENDAR_RECENT_DAYS=14

# —— 模型端点 ——
# OpenAI：OPENAI_BASE_URL 留空，OPENAI_MODEL=gpt-4o-mini（或 gpt-4o）
# DeepSeek：下面三行照着填即可（模型名 2026-10 官方为 deepseek-flash / deepseek-v4-pro）
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# DeepSeek 示例：
#   OPENAI_BASE_URL=https://api.deepseek.com
#   OPENAI_MODEL=deepseek-flash

# —— 两阶段分析与读者画像 ——
# false = 只发"中文摘要"版（旧行为）；true = 精读那几篇走"抽事实 → 按画像评估"
ANALYSIS_ENABLED=false
# 留空 = 跟随 OPENAI_MODEL。省钱可以抽取用便宜模型、评论用强模型：
#   ANALYSIS_EXTRACT_MODEL=deepseek-flash
#   ANALYSIS_ASSESS_MODEL=deepseek-v4-pro
ANALYSIS_EXTRACT_MODEL=
ANALYSIS_ASSESS_MODEL=
# 思考模式（DeepSeek 默认开启、且思考 token 按输出计费）——三态：
#   留空 = 不发这个参数（OpenAI 等端点必须留空，否则 400）
#   false = 显式关闭（结构化抽取建议关：快、省、结果更稳定）
#   true  = 显式开启（写评论、写脉搏可以开）
ANALYSIS_EXTRACT_THINKING=false
ANALYSIS_ASSESS_THINKING=
LLM_THINKING=
PROFILE_PATH=config/profile.yaml
PACKS_DIR=config/packs
# 勾选领域包；留空 = 全部启用（不影响 ARXIV_CATEGORIES 这个逃生通道）
FIELDS=galaxy_cosmology,galaxy_formation
# 默认 digest.json：回放、反馈元数据与固定评测都读它（留空 = 不落盘）
DIGEST_JSON_PATH=digest.json

# —— 全文 PDF（精读用）——
# 精读那几篇会下 PDF 抽正文：摘要里永远没有"样本怎么选、误差怎么校正"
FULLTEXT_ENABLED=true
# 送进模型的正文上限（字符）。太大贵、太小丢信息；40k ≈ 一万 token
FULLTEXT_MAX_CHARS=40000
FULLTEXT_MAX_PAGES=40
FULLTEXT_TIMEOUT=120

# —— 多源：二手解读（RSS）与会议报告（Indico）——
# 关掉就退回"只有 arXiv"的旧行为
SOURCES_ENABLED=true
SOURCES_PATH=config/sources.yaml
# 每个源最多取几条；四个源就是最多 SOURCES_MAX_ITEMS×源数 条
SOURCES_MAX_ITEMS=6
SOURCES_TIMEOUT=30

# —— 跨天状态：已读过滤 + 周环比 ——
# 必须写进仓库（Actions 每次都是干净文件系统），否则天天推同一批
STATE_PATH=state.json
TREND_ENABLED=true
# 邮件里最多显示几行趋势
TREND_ROWS=4

# —— 期刊来源：arXiv 之外再来几本天文期刊 ——
# Crossref 一个接口覆盖全部（无需 key）。关掉就只剩 arXiv。
JOURNALS_ENABLED=true
JOURNALS_PATH=config/journals.yaml
# 每本刊取多少条、最多留几篇、窗口多长（天）
JOURNALS_ROWS=40
JOURNALS_MAX_PER=6
JOURNALS_LOOKBACK_DAYS=2
JOURNALS_TIMEOUT=30
# 填一个邮箱会进 Crossref 的 polite pool（不填也能用）
JOURNALS_MAILTO=

# —— 期刊全文兜底：按标题去 arXiv 找预印本 ——
# 期刊落地页多为 HTML（IOP/Nature 反爬），直接抓 PDF 抓不到；
# 用标题反查 arXiv，命中就取预印本 PDF，邮件里仍显示期刊名与 DOI。
# 命中失败一律回退摘要，不会因为没有预印本就丢论文。
PREPRINT_ENABLED=true
PREPRINT_TIMEOUT=20
PREPRINT_MAX_RESULTS=5
# 每轮最多补几次摘要（Nature Astronomy 在 Crossref 常没有摘要）
PREPRINT_ABSTRACT_LOOKUPS=4

# —— Zotero：用你的库辅助判断（已收藏 = 读过，别再当新论文推）——
ZOTERO_API_KEY=
ZOTERO_USER_ID=
ZOTERO_LIBRARY_TYPE=user
ZOTERO_COLLECTION_ID=
# 最多读库里多少条
ZOTERO_LIMIT=100
# false（默认）= 已在库里的论文照样出现，但扣分并标注
# true = 直接过滤掉，不再出现在信里
ZOTERO_SKIP_COLLECTED=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 邮件里附一份 HTML，方便下载转发（默认 true）
EMAIL_ATTACH_HTML=true
EMAIL_FROM=
EMAIL_TO=

# ---- 本周脉搏（把"新动向"从罗列日程升级为判断什么在动）----
PULSE_ENABLED=true
# PULSE_MODEL 留空则用 OPENAI_MODEL
PULSE_MODEL=
PULSE_THREADS=4
PULSE_MAX_MATERIALS=30
# ── 邻域雷达（别的方向这周在动什么）────────────────────────
RADAR_ENABLED=true
RADAR_PATH=config/radar.yaml
RADAR_PER_FIELD=1
RADAR_MAX_FIELDS=5
RADAR_LOOKBACK_DAYS=7

# ── 二手解读中文翻译 ──────────────────────────────────────
TRANSLATE_ENABLED=true
# TRANSLATE_LIMIT 留空则 40（二手源总数也就 20-40 条，够全译）
TRANSLATE_LIMIT=
# TRANSLATE_THINKING 留空则跟随模型默认（DeepSeek 关、其他开）
TRANSLATE_THINKING=
# RADAR_THINKING 留空则跟随模型默认
RADAR_THINKING=

# ── 邮件主题 ─────────────────────────────────────────────
# dark（默认，深空冷色）/ light（暖纸浅色）
EMAIL_THEME=dark

# ── 反馈闭环（留空则邮件里不显示反馈按钮）─────────────────
# 两种接法任选其一，细节见 docs/FEEDBACK.md：
#   1) 本机端点：python scripts/feedback_server.py → FEEDBACK_URL=http://127.0.0.1:8765/log
#   2) Google Sheet：部署 Apps Script Web App → FEEDBACK_URL=<部署得到的 /exec 地址>
FEEDBACK_URL=
FEEDBACK_PATH=config/feedback.json
# 用了 Google Sheet 方案就填它的 CSV 导出地址，流水线每天把它合并进本地反馈：
# 推荐使用 docs/FEEDBACK.md 的私有 Apps Script CSV 入口，并将 URL 放入 Secret。
FEEDBACK_SHEET_CSV_URL=
FEEDBACK_SHEET_TIMEOUT=20

# —— v0.13 可靠性、缓存与隐私 ——
SMTP_TIMEOUT=30
LLM_TIMEOUT=90
FULLTEXT_PARSE_TIMEOUT=30
CACHE_DIR=.cache/arxiv-digest
RUN_REPORT_PATH=run_report.json
# 默认只在本地匹配 Zotero；true 才将标题与标签提供给模型。
ZOTERO_SHARE_WITH_MODEL=false
# 本机反馈可留空；向非本机地址开放反馈端点时必须设置。
# 密钥只放私有 .env 或 Actions Secret，不提交到仓库。
FEEDBACK_SIGNING_KEY=

# —— v0.14 周日研究总集与跨领域资讯（无需修改现有 .env 即使用默认值）——
# auto 在 DIGEST_TIMEZONE 的周日生成周报；daily / weekly 可强制覆盖。
DIGEST_EDITION=auto
WEEKLY_ENABLED=true
WEEKLY_WEEKDAY=6
# 是上限，不用弱相关论文填满。周报重新选择过去七个完整自然日的论文。
WEEKLY_MAX_PAPERS=12
WEEKLY_DEEP_PAPERS=6
WEEKLY_FETCH_MAX_RESULTS=600
WEEKLY_MIN_SIGNALS=2
# 日常也启用兴趣闸门；分类命中本身不足以入选。
PAPER_RELEVANCE_ENABLED=true
PAPER_MIN_SIGNALS=1
# 天文学 vs 物理/化学/历史合计 1:1；库存少时互相补位，不凑固定数量。
WORLD_NEWS_TARGET=30
WORLD_NEWS_MAX_ITEMS=36
WORLD_ASTRONOMY_PERCENT=50
WORLD_NEWS_MAX_AGE_DAYS=7
